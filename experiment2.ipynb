   "source": [
    "\n",
    "#convert celsius into fahrenheit\n",
    "c=float(input(\"enter celsius:\"))\n",
    "f=c*9/5+32\n",
    "print(f\"fahrenheit {f}F\")\n",
    "#convert kilometers to miles\n",
    "K=float(input(\"enter km:\"))\n",
    "m=K*0.62137\n",
    "print(round(m,2),\"miles\")\n"
   ]
